# Copy values into your shell environment (the app reads os.environ; no .env loader is included).
SECRET_KEY=<your-flask-secret>
JWT_SECRET_KEY=<your-jwt-secret>
# Optional: replaces the bundled SQLite file
DATABASE_URL=
# App password for the Gmail sender used by the Celery email jobs; emails are skipped without it
HMS_SENDER_PASSWORD=<your-app-password>
